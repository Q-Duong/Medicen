APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Claude API - trợ lý AI phòng ban (php artisan claude:setup sales)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Email nhắc đơn sắp chạy chưa xếp xe (lệnh schedule:remind)
SCHEDULE_REMIND_AT=16:00
SCHEDULE_REMIND_DAYS=2
SCHEDULE_REMIND_HOLD_DAYS=7
SCHEDULE_REMIND_TO=
# Nhắc "chưa chấm công" chỉ tính đơn chụp từ ngày này (mặc định 2026-11-01)
SCHEDULE_TIMEKEEPING_FROM=2026-11-01

# Báo cáo thu chi: email nhận (nhiều email cách nhau bằng dấu phẩy)
# - nhắc khoản thu/chi sắp đến hạn / quá hạn (lệnh reports:remind, 10:00 hằng ngày)
REPORT_REMIND_TO=
# - khi cập nhật dòng báo cáo có chọn gửi mail
REPORT_UPDATED_TO=

# Form Liên hệ / đặt lịch trên trang chủ: email nhận và cc (nhiều email cách nhau bằng dấu phẩy)
CONTACT_MAIL_TO=
CONTACT_MAIL_CC=

# Cảnh báo tài chính thứ Hai + báo cáo CFO đầu tháng (để trống = dùng REPORT_REMIND_TO + REPORT_UPDATED_TO)
FINANCE_REPORT_TO=
# Nhật ký Sales: email nhắc việc 17:00 (nhiều email cách nhau dấu phẩy; để trống = không gửi)
SALES_DIGEST_TO=
